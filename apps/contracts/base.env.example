# Base mainnet deploy configuration — Nimiq Pay migration.
#
# Copy to .env (gitignored). Foundry auto-loads .env from the project root —
# no `source` needed, and `export` prefixes and $VAR interpolation both work
# (verified by dry-running with these variables unset in the shell):
#
#   cp base.env.example .env
#   forge script script/Deploy.s.sol --rpc-url base --sender <addr>   # dry run
#   forge script script/Deploy.s.sol --broadcast --rpc-url base --account <keystore>
#
# The signing key is NOT in this file and must never be: this file gets sourced,
# cat'd, backed up and screen-shared. Use `cast wallet import <name>
# --interactive` (encrypted keystore) or --ledger.
#
# Every value below is READ FROM THE LIVE CELO WORLD DEPLOYMENT
# (0xA8cFC1B4365518f56954382B6Fab25a5382f5C49) via `cast call` on
# 2026-08-24, so Base reproduces the economics currently in production
# rather than the placeholder numbers in deploy.env.example — which have
# drifted from production (that file still says $0.01 / 182 days).
#
#   initialPrice   30000    ($0.03 at PRICE_DECIMALS=6)
#   minPrice       1        ($0.000001)
#   feeRate        500      (5% resale fee, bps)
#   HALVING_TIME   2592000s (30 days)
#   PRICE_DECIMALS 6
#
# Re-read them before deploying — they are owner-mutable and may have moved:
#   cast call <celo-proxy> 'initialPrice()(uint256)' --rpc-url https://forno.celo.org

# Accepted stablecoins, all treated 1:1 when buying pixels. Comma-separated, NO spaces.
# Each must be a real ERC-20 — initialize() reads decimals() on-chain and reverts otherwise.
#
# Both addresses verified on Base mainnet via eth_call (symbol + decimals):
#   USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  6 decimals
#   USDT 0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2  6 decimals
#
# NOTE: the Celo deployment accepts three tokens (USD₮, USDC, USDm) and USDm is
# 18-decimal. Base has no USDm; both tokens here are 6-decimal. The contract
# scales per token, so this is safe — but the frontend's KNOWN_DECIMALS map in
# hooks/useStablecoinBalance.ts must list every token you put here.
export ACCEPTED_TOKENS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2

export INITIAL_PRICE=30000    # $0.03 in 6-decimal base units — matches Celo prod
export MIN_PRICE=1            # $0.000001 — matches Celo prod
export HALVING_TIME_DAYS=30   # 2592000s on Celo prod (NOT the 182 in deploy.env.example)
export INITIAL_FEE_RATE=500   # 5% resale fee in bps — matches Celo prod; max 2000

# RPC. `--rpc-url base` resolves BASE_RPC_URL via foundry.toml [rpc_endpoints].
export BASE_RPC_URL=https://mainnet.base.org
export ETH_RPC_URL=$BASE_RPC_URL

# Optional: single-continent deploy. Omit for the world map.
# export LAND_MASK_PATH=map/continents/africa.json

# Set after the first deploy — read by script/pay_leaders.py and player_pnl.py.
# export PROXY_ADDRESS=0x...
