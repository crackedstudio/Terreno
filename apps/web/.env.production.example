# Terreno — production environment (Vercel / any host).
#
# EVERY variable here is OPTIONAL. The app runs with all of them unset: the
# world map's address and reveal state live in src/lib/maps/contracts.ts, not
# in env. Set these to improve on the defaults, not to make it work.
#
# NEXT_PUBLIC_* is inlined at BUILD time. Changing one in the Vercel dashboard
# does nothing until you redeploy.

# ── Recommended for production ────────────────────────────────────────────

# Authenticated Base RPC. The default is the public https://mainnet.base.org,
# which will rate-limit under real traffic. Any provider works (Alchemy, Infura,
# QuickNode, dRPC). The URL ships in the client bundle — protect it with a
# domain allowlist on the provider dashboard, not by hiding it.
NEXT_PUBLIC_BASE_RPC_URL=

# Privy app id — the desktop-browser wallet connect UI. Nimiq Pay users never
# touch this path; browser visitors do.
#
# SET THIS. Unset falls back to a hardcoded app id belonging to the previous
# project (wallet-provider-privy.tsx). That project is not yours, its domain
# allowlist will not include your domain, and it can be revoked at any time —
# so browser connect would break with no code change on your side.
NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect / Reown project id, for Privy's desktop QR flow.
# Create at https://cloud.reown.com and allowlist your domain.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# PostHog project key (US cloud). Analytics + error tracking stay off while
# blank; the app works without it.
NEXT_PUBLIC_POSTHOG_KEY=

# ── Optional ──────────────────────────────────────────────────────────────

# Google Form URL for the in-app SUPPORT button. Falls back to the committed
# default in lib/deeplinks.ts.
NEXT_PUBLIC_SUPPORT_FORM_URL=

# Goldsky subgraph endpoint. Unset = the app falls back to live log-scan reads,
# which is slower but correct. MUST name a Base deployment: subgraphConfigured()
# fails closed on a URL not containing "base", so a subgraph for another chain
# cannot silently serve the wrong chain's ownership data.
NEXT_PUBLIC_GOLDSKY_SUBGRAPH_URL=

# Host-wallet top-up deeplink. LEAVE UNSET — no verified Nimiq Pay funding
# deeplink exists, and unset hides the CTA rather than linking somewhere broken.
NEXT_PUBLIC_TOPUP_URL=

# Base Builder Code (ERC-8021) override. Leave unset — src/lib/attribution.ts
# already carries the enrolled code, and this only overrides it. Inlined at
# BUILD time, so setting it here needs a redeploy to take effect, and a value
# that is not a minted code silently attributes nothing.
NEXT_PUBLIC_BASE_BUILDER_CODE=

# ── Leave unset in production ─────────────────────────────────────────────

# Preview-only map address override ("0:0xabc…,1:0xdef…"). The registry in
# src/lib/maps/contracts.ts is the source of truth in production.
# NEXT_PUBLIC_MAP_ADDRESS_OVERRIDES=

# Reveal override. The world map is already revealed: true in the registry;
# set this only to open continents before editing the registry.
# NEXT_PUBLIC_REVEALED_MAP_IDS=

# Tuning knobs — all have sane defaults (2% slippage, 20min deadline, $2).
# NEXT_PUBLIC_BUY_SLIPPAGE_BPS=
# NEXT_PUBLIC_BUY_DEADLINE_SECONDS=
# NEXT_PUBLIC_MAP_THRESHOLD_USD=

# ── First-land grant campaign ─────────────────────────────────────────────
#
# Gives a wallet that has never owned land its first plot free, paid by a
# sponsor wallet through buyPixelsFor. Full runbook: docs/DEPLOYMENT.md.
#
# NOTE: this file is DOCUMENTATION. Next.js loads .env, .env.local,
# .env.production and .env.production.local — never a *.example. On Vercel the
# real values live in Settings → Environment Variables, and a change there does
# nothing until you redeploy.

# The only switch. Exactly "1" turns the campaign on; anything else leaves it
# off. Unset it (or let the sponsor run dry) to end a campaign.
# GRANT_ENABLED=1

# Pays for grants. UNSET means the NIM settler's wallet, which is already
# funded and already approved to spend through the contract — so a campaign
# needs no new wallet. That convenience has a cost: the settler owes land to
# players who have already sent NIM, and a giveaway drawing on the same float
# can leave one of them waiting until somebody refills it. Set this to a
# separate, separately-funded, separately-approved wallet before a campaign
# goes wide. A MALFORMED value here disables grants rather than quietly
# falling back to the settler.
# GRANT_SPONSOR_PRIVATE_KEY=

# Headline size in whole NIM. This is the number players see, priced per
# request against the live NIM/USD feed. Default 500 (~$0.19).
# GRANT_NIM_AMOUNT=500

# Blast-radius ceiling on ONE claim, in 6-decimal USD MICROS — $2 is 2000000,
# not 2. Bounds what a price-feed spike can draw. When it binds, the player is
# shown the smaller NIM amount it actually buys, so the copy stays true.
# GRANT_MAX_USD_MICROS=2000000

# Most pixels one grant may buy. Bounds the calldata as well as the spend.
# GRANT_MAX_PIXELS=25

# Stablecoin to pay with. Unset means the contract's first accepted token,
# validated against getAcceptedTokens() rather than trusted.
# GRANT_TOKEN=

# HARD DEPENDENCY, no default: NEXT_PUBLIC_GOLDSKY_SUBGRAPH_URL (above) must be
# set AND name a Base deployment. Eligibility is "has this wallet ever acquired
# land", read from the subgraph's monotonic Owner.totalSpent. With no subgraph
# there is no safe answer, so every claim refuses rather than guessing.
